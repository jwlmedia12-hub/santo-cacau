# Copie este arquivo para ".env" e preencha. O ".env" NÃO vai para o GitHub.

# Porta do servidor (local). Em hospedagens como o Render ela é definida sozinha.
PORT=3000

# Endereço público do servidor/site, com https em produção.
# Usado nos links de e-mail, na volta do Mercado Pago e nas notificações (webhook).
PUBLIC_URL=http://localhost:3000
# Opcional: endereço do site se for diferente do servidor (ex.: GitHub Pages).
# SITE_URL=https://jwlmedia12-hub.github.io/santo-cacau

# Sites autorizados a chamar a API de outro endereço (separe por vírgula).
# ALLOWED_ORIGINS=https://jwlmedia12-hub.github.io

# ---------- Mercado Pago ----------
# Painel: https://www.mercadopago.com.br/developers/panel/app
# Use primeiro a credencial de TESTE (começa com TEST-). Sem ela, o pagamento é simulado.
MP_ACCESS_TOKEN=
# Assinatura secreta do webhook (painel > Webhooks). Recomendado em produção.
MP_WEBHOOK_SECRET=
# Validade do QR Code Pix, em minutos.
PIX_EXPIRA_MINUTOS=30

# ---------- E-mail (opcional) ----------
# Sem SMTP, os e-mails (ex.: link de nova senha) aparecem no terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_REMETENTE=Santo Cacau <nao-responda@santocacau.com.br>

# ---------- Banco de dados ----------
# Arquivo SQLite. Em produção, aponte para um disco persistente.
# DB_PATH=/var/data/santo-cacau.db
