{
  "name": "santo-cacau",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "site": "http-server www -p 8080 -c-1",
    "start": "concurrently -k -n server,app -c yellow,cyan \"npm:server\" \"npm:app\"",
    "web": "concurrently -k -n server,app -c yellow,cyan \"npm:server\" \"expo start --web\"",
    "android": "concurrently -k -n server,app -c yellow,cyan \"npm:server\" \"expo start --android\"",
    "ios": "concurrently -k -n server,app -c yellow,cyan \"npm:server\" \"expo start --ios\"",
    "format": "prettier --write \"www/**/*.{html,css,js}\" \"src/**/*.js\" \"server/**/*.js\" \"*.js\"",
    "app": "expo start",
    "deploy:pages": "git subtree split --prefix www -b gh-pages-temp && git push -f origin gh-pages-temp:gh-pages && git branch -D gh-pages-temp",
    "server": "node --env-file-if-exists=.env server/index.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-speech": "~58.0.3",
    "expo-status-bar": "~58.0.4",
    "express": "^4.21.2",
    "nodemailer": "^6.9.16",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "http-server": "^14.1.1",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=22.13"
  }
}
